---
import BaseLayout from "./BaseLayout.astro";
import "../styles/post.css";
import type { CollectionEntry } from "astro:content";

interface Props {
  fragment: CollectionEntry<"fragments">;
}

const { fragment } = Astro.props;
const { title, date, description } = fragment.data;

// timeZone: "UTC" keeps a date written as `2026-08-11` from rendering as the
// 10th for readers west of Greenwich. Same reasoning as NewsList.astro.
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  displayPageName
  pageTitle={`Stefan Grünewald: ${title}`}
  description={description}
>
  <article class="post">
    <div class="post-column mt-5">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <p class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </p>
      </header>
    </div>

    <div class="post-body">
      <slot />
    </div>

    <div class="post-column post-nav">
      <a href="/fragments/">&larr; All fragments</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-title {
    /* Slightly tighter than the default heading leading, which is loose at
       the sizes a long post title reaches. */
    line-height: 1.2;
  }

  .post-header {
    margin-bottom: 1.5rem;
  }
</style>
